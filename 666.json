<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Love Wonderland 💖</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Raleway:wght@400;700&display=swap');

        body {
            font-family: 'Raleway', sans-serif;
            text-align: center;
            background: linear-gradient(to bottom, #ffdde1, #ff8fab);
            color: #a00000;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .container {
            max-width: 90%;
            text-align: center;
        }

        h1 {
            font-size: clamp(32px, 8vw, 80px);
            font-family: 'Great Vibes', cursive;
            font-weight: bold;
            color: #ff0040;
            text-shadow: 0 0 20px rgba(255, 0, 0, 0.8);
            animation: glow 2s infinite alternate;
        }

        p {
            font-size: clamp(14px, 4vw, 22px);
            color: #700000;
        }

        button {
            background: linear-gradient(45deg, #ff4d6d, #ff1e56);
            color: white;
            border: none;
            padding: 10px 25px;
            font-size: clamp(14px, 4vw, 22px);
            cursor: pointer;
            border-radius: 30px;
            margin-top: 20px;
            box-shadow: 0 4px 15px rgba(255, 0, 0, 0.4);
            transition: 0.4s;
        }

        button:hover {
            background: linear-gradient(45deg, #d00000, #a00000);
            transform: scale(1.05);
        }

        #message {
            font-size: clamp(16px, 4vw, 24px);
            color: #a00000;
            margin-top: 20px;
            display: none;
        }

        .countdown {
            font-size: clamp(14px, 4vw, 22px);
            font-weight: bold;
            color: white;
            background: rgba(255, 0, 0, 0.6);
            padding: 8px 16px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 20px;
        }

        .rabbit {
            position: fixed;
            bottom: 5vh;
            left: 50%;
            transform: translateX(-50%);
            width: clamp(60px, 15vw, 100px);
            animation: bounce 2s infinite alternate;
            cursor: pointer;
        }

        @keyframes bounce {
            0% { transform: translate(-50%, 0); }
            100% { transform: translate(-50%, -10px); }
        }
    </style>
</head>
<body onload="updateCountdown()">

    <div class="container">
        <h1>Love Wonderland 💖</h1>
        <p>A special gift for you, my love!</p>
        <button onclick="showMessage()">Click here for a surprise 🎁</button>
        <p id="message">I love you forever! ❤️ You are my everything! 💕</p>
        <div class="countdown" id="countdown"></div>
    </div>

    <img src="https://i.imgur.com/3mLVhwb.png" class="rabbit" onclick="rabbitSurprise()" title="Click me! 🐰❤️">

    <script>
        function showMessage() {
            document.getElementById("message").style.display = "block";
        }

        function rabbitSurprise() {
            alert("The rabbit says: 'I love you too! 🐰❤️'");
        }

        function updateCountdown() {
            const eventDate = new Date("February 14, 2025 00:00:00").getTime();
            const now = new Date().getTime();
            const distance = eventDate - now;

            if (distance < 0) {
                document.getElementById("countdown").innerHTML = "Happy Valentine's Day! 🎉";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("countdown").innerHTML = `Valentine's Day in: ${days}d ${hours}h ${minutes}m ${seconds}s`;
        }

        setInterval(updateCountdown, 1000);
    </script>

</body>
</html>
